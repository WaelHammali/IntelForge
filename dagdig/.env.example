# DAGDIG Environment Configuration
# Copy this file to .env and fill in your values

# Stage 1: HTML Cleaner AI
GROQ_API_KEY="your-groq-api-key-here"
GROQ_MODEL="groq/compound-mini"

# Stage 2: Attack Surface & Keyword Parser
GROQ_API_KEY_2="your-groq-api-key-here"
GROQ_MODEL_2="openai/gpt-oss-120b"

# Stage 3: Exploit & CVE Researcher (DeepSeek R1 Reasoning Model)
GROQ_API_KEY_3="your-groq-api-key-here"
GROQ_MODEL_3="deepseek-r1-distill-llama-70b"

# Scan Settings
SCAN_TIMEOUT=600
FUZZ_THREADS=20

