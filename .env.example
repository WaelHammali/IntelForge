# IntelForge configuration — copy to .env and fill in.
# All settings can also be passed as environment variables with the INTELFORGE_ prefix.

# ─── LLM roles ────────────────────────────────────────────────────────────────
# Model strings use LangChain's "provider:model" form and work with any provider
# supported by langchain.chat_models.init_chat_model
# (groq, openai, google_genai, openai-compatible via base_url, ...).
INTELFORGE_LLM_CLEANER="groq:llama-3.1-8b-instant"
INTELFORGE_LLM_ANALYST="groq:llama-3.3-70b-versatile"
INTELFORGE_LLM_RESEARCHER="groq:deepseek-r1-distill-llama-70b"

# API keys — set the ones your chosen providers need.
GROQ_API_KEY=""
# OPENAI_API_KEY=""
# GOOGLE_API_KEY=""
# OPENROUTER_API_KEY=""

# Optional: OpenAI-compatible gateway (OpenRouter, local vLLM, ...)
# INTELFORGE_LLM_BASE_URL="https://openrouter.ai/api/v1"

# ─── Back-compat ──────────────────────────────────────────────────────────────
# If these legacy vars are set and the INTELFORGE_LLM_* vars are not, they are
# mapped automatically (GROQ_MODEL -> cleaner, _2 -> analyst, _3 -> researcher).
# GROQ_MODEL="llama-3.1-8b-instant"
# GROQ_MODEL_2="llama-3.3-70b-versatile"
# GROQ_MODEL_3="deepseek-r1-distill-llama-70b"

# ─── Tools & scanning ─────────────────────────────────────────────────────────
INTELFORGE_FINALRECON_PATH="/home/themangahacker/FinalRecon/finalrecon.py"
INTELFORGE_REQUEST_TIMEOUT=10
INTELFORGE_FUZZ_THREADS=20
INTELFORGE_SCAN_TIMEOUT=600

# Data / wordlist locations (relative to the working directory by default).
INTELFORGE_DATA_DIR="data"
INTELFORGE_WORDLIST_DIR="wordlists"
